POSTGRES_USER=tmt
POSTGRES_PASSWORD=tmt_change_me
POSTGRES_DB=tmt_workspace

# Replace before running the Docker backend; development/production reject placeholders.
TMT_SECRET_KEY=change-me-in-local-only
TMT_DEBUG=false

# Authentication (Phase 1B defaults shown; override per environment)
TMT_ACCESS_TOKEN_TTL_MINUTES=30
TMT_REFRESH_TOKEN_TTL_DAYS=14
TMT_REFRESH_COOKIE_NAME=tmt_refresh_token
TMT_REFRESH_COOKIE_PATH=/api/v1/auth
TMT_REFRESH_COOKIE_SAMESITE=lax
# Production forces this to true regardless of the value here.
TMT_REFRESH_COOKIE_SECURE=false
TMT_LOGIN_MAX_ATTEMPTS=10
TMT_LOGIN_WINDOW_SECONDS=300
