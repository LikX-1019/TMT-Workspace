TMT_ENVIRONMENT=local
TMT_DEBUG=true
TMT_PROJECT_NAME=TMT Workspace

TMT_DATABASE_URL=postgresql+asyncpg://tmt:tmt_change_me@localhost:5432/tmt_workspace
TMT_DB_ECHO=false

TMT_REDIS_URL=redis://localhost:6379/0

TMT_API_V1_PREFIX=/api/v1
TMT_CORS_ORIGINS=["http://localhost:5173"]

TMT_SECRET_KEY=change-me-in-local-only
TMT_ACCESS_TOKEN_TTL_MINUTES=30
TMT_REFRESH_TOKEN_TTL_DAYS=14
TMT_JWT_ALGORITHM=HS256

# Refresh cookie (production forces TMT_REFRESH_COOKIE_SECURE=true)
TMT_REFRESH_COOKIE_NAME=tmt_refresh_token
TMT_REFRESH_COOKIE_PATH=/api/v1/auth
TMT_REFRESH_COOKIE_SAMESITE=lax
TMT_REFRESH_COOKIE_SECURE=false

# Login brute-force protection (Redis-backed counters)
TMT_LOGIN_MAX_ATTEMPTS=10
TMT_LOGIN_WINDOW_SECONDS=300

